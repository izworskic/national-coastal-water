{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/national-tools/coastal/oregon/_api/decision",
      "destination": "/api/oregon-coastal"
    },
    {
      "source": "/national-tools/coastal/oregon",
      "destination": "/national-tools/coastal/oregon/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/",
      "destination": "/national-tools/coastal/oregon/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/yaquina-head",
      "destination": "/national-tools/coastal/oregon/yaquina-head/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/yaquina-head/",
      "destination": "/national-tools/coastal/oregon/yaquina-head/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/haystack-rock",
      "destination": "/national-tools/coastal/oregon/haystack-rock/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/haystack-rock/",
      "destination": "/national-tools/coastal/oregon/haystack-rock/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/hug-point",
      "destination": "/national-tools/coastal/oregon/hug-point/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/hug-point/",
      "destination": "/national-tools/coastal/oregon/hug-point/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/thors-well",
      "destination": "/national-tools/coastal/oregon/thors-well/index.html"
    },
    {
      "source": "/national-tools/coastal/oregon/thors-well/",
      "destination": "/national-tools/coastal/oregon/thors-well/index.html"
    },
    {
      "source": "/national-tools/thunder-hole-live/_api/live",
      "destination": "/api/thunder-hole"
    },
    {
      "source": "/national-tools/coastal/thunder-hole-live/_api/live",
      "destination": "/api/thunder-hole"
    },
    {
      "source": "/national-tools/coastal/thunder-hole-live",
      "destination": "/national-tools/thunder-hole-live/index.html"
    },
    {
      "source": "/national-tools/coastal/thunder-hole-live/",
      "destination": "/national-tools/thunder-hole-live/index.html"
    },
    {
      "source": "/national-tools/coastal/thunder-hole-live/:path*",
      "destination": "/national-tools/thunder-hole-live/:path*"
    }
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public"
}
