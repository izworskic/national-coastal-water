{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/national-tools/thunder-hole-live/_api/live",
      "destination": "/api/thunder-hole"
    }
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public"
}
